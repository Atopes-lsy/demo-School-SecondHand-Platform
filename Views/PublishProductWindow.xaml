<Window x:Class="School二手Platform.Views.PublishProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:School二手Platform.Models"
        xmlns:cv="clr-namespace:School二手Platform.Converters"
        Title="发布闲置" Height="560" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#F5F6FA" ResizeMode="NoResize">

    <Window.Resources>
        <cv:ProductConditionToTextConverter x:Key="CondText"/>
        <cv:PriceStrategyToTextConverter x:Key="StratText"/>

        <Style TargetType="TextBlock" x:Key="FormLabel">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,25">
            <TextBlock Text="📦 发布闲置物品" FontSize="22" FontWeight="Bold"
                       Foreground="#2C3E50" Margin="0,0,0,20"/>

            <!-- Title -->
            <TextBlock Text="商品标题 *" Style="{StaticResource FormLabel}"/>
            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                     Height="36" FontSize="14" Padding="10,6"
                     VerticalContentAlignment="Center"/>

            <!-- Description -->
            <TextBlock Text="商品描述" Style="{StaticResource FormLabel}"/>
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     Height="80" FontSize="13" Padding="10,8"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>

            <!-- Price -->
            <TextBlock Text="价格（元）*" Style="{StaticResource FormLabel}"/>
            <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                     Height="36" FontSize="14" Padding="10,6"
                     VerticalContentAlignment="Center"/>

            <!-- Category -->
            <TextBlock Text="商品分类" Style="{StaticResource FormLabel}"/>
            <ComboBox ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory}"
                      Height="36" FontSize="14" Padding="8,0"/>

            <!-- Condition -->
            <TextBlock Text="新旧/余量状态" Style="{StaticResource FormLabel}"/>
            <ComboBox ItemsSource="{Binding ConditionOptions}"
                      SelectedItem="{Binding SelectedCondition}"
                      Height="36" FontSize="14" Padding="8,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource CondText}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Strategy -->
            <TextBlock Text="价格机制" Style="{StaticResource FormLabel}"/>
            <ComboBox ItemsSource="{Binding StrategyOptions}"
                      SelectedItem="{Binding SelectedStrategy}"
                      Height="36" FontSize="14" Padding="8,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource StratText}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Status Message -->
            <TextBlock Text="{Binding StatusMessage}" FontSize="13"
                       Foreground="#27AE60" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,10,0,0"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="取消" Width="90" Height="38"
                        Command="{Binding CancelCommand}"
                        FontSize="14" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#95A5A6" CornerRadius="6" Cursor="Hand">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="✅ 发布" Width="120" Height="38" Margin="15,0,0,0"
                        Command="{Binding PublishCommand}"
                        FontSize="14" FontWeight="Bold" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#3498DB" CornerRadius="6" Cursor="Hand">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
