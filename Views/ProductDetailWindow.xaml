<Window x:Class="School二手Platform.Views.ProductDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cv="clr-namespace:School二手Platform.Converters"
        Title="商品详情" Height="520" Width="550"
        WindowStartupLocation="CenterOwner"
        Background="#F5F6FA" ResizeMode="NoResize">

    <Window.Resources>
        <cv:ProductConditionToTextConverter x:Key="ConditionToText"/>
        <cv:PriceStrategyToTextConverter x:Key="StrategyToText"/>
        <cv:ConditionToBadgeColorConverter x:Key="ConditionColor"/>
        <cv:StrategyToBadgeColorConverter x:Key="StrategyColor"/>
        <cv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <cv:PriceToStringConverter x:Key="PriceToString"/>
        <cv:BoolToFavoriteIconConverter x:Key="FavoriteIcon"/>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title + Badges + Favorite -->
        <StackPanel Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Product.Title}" FontSize="22" FontWeight="Bold"
                           Foreground="#2C3E50" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <!-- Favorite Toggle Button -->
                <Button Grid.Column="1" Width="40" Height="40"
                        Command="{Binding ToggleFavoriteCommand}"
                        Cursor="Hand" Margin="10,0,0,0"
                        VerticalAlignment="Top">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#FEE2E2" CornerRadius="20"
                                    Padding="8">
                                <TextBlock Text="{Binding IsFavorited, Converter={StaticResource FavoriteIcon}}"
                                           FontSize="20" Foreground="#E74C3C"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
            <StackPanel Orientation="Horizontal">
                <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                        Background="{Binding Product.Condition, Converter={StaticResource ConditionColor}}">
                    <TextBlock Text="{Binding Product.Condition, Converter={StaticResource ConditionToText}}"
                               Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                </Border>
                <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                        Background="{Binding Product.Strategy, Converter={StaticResource StrategyColor}}">
                    <TextBlock Text="{Binding Product.Strategy, Converter={StaticResource StrategyToText}}"
                               Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                </Border>
                <Border CornerRadius="4" Padding="6,2" Background="#9B59B6">
                    <TextBlock Text="{Binding Product.Category}" Foreground="White"
                               FontSize="12" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Product Details -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Margin="0,15,0,0" Padding="20">
            <StackPanel>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="商品描述" FontSize="14" FontWeight="Bold"
                               Foreground="#2C3E50" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="1" Text="{Binding Product.Description}"
                               FontSize="13" Foreground="#555" TextWrapping="Wrap"
                               VerticalAlignment="Top"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="价格" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Product.Price, Converter={StaticResource PriceToString}}"
                               FontSize="22" FontWeight="Bold" Foreground="#E74C3C"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="卖家ID" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                    <TextBlock Grid.Column="1" Text="{Binding Product.SellerId}"
                               FontSize="14" Foreground="#555"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="发布时间" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                    <TextBlock Grid.Column="1" Text="{Binding Product.CreatedTime, StringFormat='yyyy-MM-dd HH:mm'}"
                               FontSize="14" Foreground="#555"/>
                </Grid>

                <!-- Status Message (visible only when non-empty) -->
                <TextBlock Text="{Binding StatusMessage}" FontSize="13"
                           Foreground="#27AE60" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Action Area -->
        <Border Grid.Row="2" Margin="0,15,0,0">
            <Grid>
                <!-- Fixed Price: Direct Order -->
                <StackPanel Visibility="{Binding IsFixedPrice, Converter={StaticResource BoolToVis}}">
                    <Button Content="📋 一键生成面交订单" Height="45"
                            Command="{Binding CreateOrderCommand}"
                            FontSize="16" FontWeight="Bold" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#27AE60" CornerRadius="8" Cursor="Hand">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Highest Bidder: Bid Area -->
                <StackPanel Visibility="{Binding IsHighestBidder, Converter={StaticResource BoolToVis}}">
                    <TextBlock FontSize="15" Foreground="#2C3E50" Margin="0,0,0,8">
                        <Run Text="当前最高出价："/>
                        <Run Text="{Binding Product.Price, Converter={StaticResource PriceToString}, Mode=OneWay}"
                             Foreground="#E74C3C" FontSize="18" FontWeight="Bold"/>
                        <Run Text=" 元" FontSize="13"/>
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding Product.CurrentHighestBidderId, StringFormat='当前出价人ID：{0}'}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Product.CurrentHighestBidderId}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="我的出价（元）" FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding BidAmount, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="16" Height="40" VerticalContentAlignment="Center"
                                     Padding="10,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="⚡ 我要出价" Width="120" Height="40" Margin="10,0,0,0"
                                Command="{Binding PlaceBidCommand}"
                                FontSize="14" FontWeight="Bold" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#E67E22" CornerRadius="8" Cursor="Hand">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
